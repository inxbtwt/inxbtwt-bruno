meta {
  name: Aceitar solicitação recebida
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/friendships/{{friendUserId}}/accept
  body: none
  auth: none
}

headers {
  Accept: application/json
}

script:pre-request {
  const target = bru.getEnvVar("friendUserId") || bru.getVar("friendUserId") || bru.getVar("viewedUserId");
  if (!target) throw new Error("Defina friendUserId ou execute Visualizar perfil por username para selecionar outra pessoa.");
  bru.setVar("friendUserId", target);
}

docs {
  Exige login e CSRF.
  Somente o destinatário aceita. Torna os dois usuários amigos e notifica o remetente. Aceite repetido não duplica o aviso.
  Ação da parte errada retorna 403; estado incompatível retorna 409.
}
