vars:pre-request {
  baseUrl: https://localhost:8081
  loginPassword: SenhaTeste123
}

script:pre-request {
  const method = req.getMethod().toUpperCase();

  if (!["GET", "HEAD", "OPTIONS", "TRACE"].includes(method)) {
    const token = bru.getVar("csrfToken");
    const headerName = bru.getVar("csrfHeaderName");

    if (!token || !headerName) {
      throw new Error("Execute Preparação > Obter CSRF antes de enviar esta requisição.");
    }

    req.setHeader(headerName, token);
  }
}
