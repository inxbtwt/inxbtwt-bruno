meta {
  name: Consultar publicação
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/posts/{{postId}}
  body: none
  auth: none
}

headers {
  Accept: application/json
}

script:pre-request {
  const postIdValue = bru.getEnvVar("postId") || bru.getVar("postId");
  if (!postIdValue) throw new Error("Defina postId no ambiente ou execute a preparação indicada na documentação.");
  bru.setVar("postId", postIdValue);
}

script:post-response {
  if (res.getStatus() >= 200 && res.getStatus() < 300) {
    const post = res.getBody().data;
    bru.setVar("postId", post.postId);
    bru.setVar("lastPost", JSON.stringify(post));
    bru.deleteVar("postMediaId");
    const media = (post.media || []).find((item) => item.provider === "UPLOAD");
    if (media) bru.setVar("postMediaId", media.mediaId);
  }
}

docs {
  Defina postId ou crie uma publicação. Retorna autor, texto, mídias, contadores e estados liked/reposted do solicitante.
  Publicação removida ou inexistente retorna 404.
}
