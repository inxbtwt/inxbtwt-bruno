meta {
  name: Criar publicação de texto
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/posts
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "content": "{{postContent}}"
  }
}

script:post-response {
  if (res.getStatus() >= 200 && res.getStatus() < 300) {
    const post = res.getBody().data;
    bru.setVar("postId", post.postId);
    bru.setVar("lastPost", JSON.stringify(post));
    bru.deleteVar("postMediaId");
    const media = (post.media || []).find((item) => item.provider === "UPLOAD");
    if (media) bru.setVar("postMediaId", media.mediaId);
  }
}

docs {
  Exige login e CSRF. Cria dados no banco. O autor vem da sessão.
  Salva postId, lastPost e postMediaId quando houver anexo local.
}
