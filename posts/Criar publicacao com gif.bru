meta {
  name: Criar publicação com GIF local
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/posts
  body: multipartForm
  auth: none
}

headers {
  Accept: application/json
}

body:multipart-form {
  content: {{postContent}}
  media: @file(fixtures/post-sample.gif) @contentType(image/gif)
}

script:post-response {
  if (res.getStatus() >= 200 && res.getStatus() < 300) {
    const post = res.getBody().data;
    bru.setVar("postId", post.postId);
    bru.setVar("lastPost", JSON.stringify(post));
    bru.deleteVar("postMediaId");
    const media = (post.media || []).find((item) => item.provider === "UPLOAD");
    if (media) bru.setVar("postMediaId", media.mediaId);
  }
}

docs {
  Exige login e CSRF. Envia um GIF mínimo de exemplo em fixtures/post-sample.gif.
  Pode substituir o arquivo por um GIF animado de até 10 MiB. Não misture com outras imagens.
  O servidor preserva os bytes originais, sem converter a animação.
}
