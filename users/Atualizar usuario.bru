meta {
  name: Atualizar usuário (PUT)
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/users/{{userId}}
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "name": "Maria Atualizada",
    "photoUrl": "http://localhost:8333/inxbtwt-files/avatar.png",
    "email": "{{testEmail}}",
    "phone": "11888888888",
    "password": "SenhaTeste123"
  }
}

script:pre-request {
  if (!bru.getVar("userId")) {
    throw new Error("Execute primeiro Criar usuário para preencher userId.");
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("lastUser", JSON.stringify(res.getBody().data));
  }
}

tests {
  test("HTTP 200 e resposta padronizada", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.status).to.equal("OK");
    expect(body.message).to.be.a("string").and.not.empty;
    expect(body).not.to.have.property("exception");
    expect(body).not.to.have.property("trace");
    expect(body.data).not.to.have.property("password");
  });
  test("Dados retornados correspondem ao fluxo", function () {
    const body = res.getBody();
    expect(body.data.userId).to.equal(bru.getVar("userId"));
    expect(body.data.name).to.equal("Maria Atualizada");
    expect(body.data.email).to.equal(bru.getVar("testEmail"));
    expect(body.data.phone).to.equal("11888888888");
  });
}
