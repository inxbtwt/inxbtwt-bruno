meta {
  name: Listar usuários
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/users?page=0&size=20
  body: none
  auth: none
}

headers {
  Accept: application/json
}

tests {
  test("HTTP 200 e resposta padronizada", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.status).to.equal("OK");
    expect(body.message).to.be.a("string").and.not.empty;
    expect(body).not.to.have.property("exception");
    expect(body).not.to.have.property("trace");
    for (const user of body.data.content) expect(user).not.to.have.property("password");
  });
  test("Dados retornados correspondem ao fluxo", function () {
    const body = res.getBody();
    expect(body.data.content).to.be.an("array");
    expect(body.data.number).to.equal(0);
    expect(body.data.size).to.equal(20);
  });
}
