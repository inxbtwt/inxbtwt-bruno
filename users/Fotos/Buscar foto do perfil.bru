meta {
  name: Buscar foto do perfil
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/users/{{userId}}/photo?url={{photoUrl}}
  body: none
  auth: none
}

headers {
  Accept: image/png, application/json
}

script:pre-request {
  if (!bru.getVar("userId") || !bru.getVar("photoUrl")) {
    throw new Error("Execute primeiro o cadastro e o envio da foto.");
  }
}

tests {
  test("Busca retorna a imagem como binário", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("content-type")).to.include("image/png");
    expect(Number(res.getHeader("content-length"))).to.be.greaterThan(0);
  });
}

docs {
  Busca a imagem pela URL salva para este usuário. A resposta de sucesso é a imagem binária, sem ApiResponse.
}
