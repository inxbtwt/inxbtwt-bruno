meta {
  name: Buscar capa do perfil visualizado
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/users/{{viewedUserId}}/photo?url={{viewedCoverUrl}}
  body: none
  auth: none
}

params:query {
  url: {{viewedCoverUrl}}
}

headers {
  Accept: image/png, image/jpeg, image/webp, application/json
}

script:pre-request {
  if (!bru.getVar("viewedUserId") || !bru.getVar("viewedCoverUrl")) {
    throw new Error("Execute Visualizar perfil por username. O perfil precisa ter capa cadastrada.");
  }
}

docs {
  Baixa a capa do perfil visualizado pela API autenticada, sem acessar diretamente o bucket.
  Retorna imagem binária, sem ApiResponse em caso de sucesso. Exige login pelo Cookie Jar.
}
