meta {
  name: Criar usuário
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/users
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "name": "Lucas Oliveira",
    "username": "{{testUsername}}",
    "email": "{{testEmail}}",
    "phone": "{{testPhone}}",
    "password": "{{loginPassword}}",
    "addresses": [
      {
        "street": "Rua de Teste",
        "city": "São Paulo",
        "state": "SP",
        "zipCode": "01001000",
        "country": "Brasil",
        "referenceName": "Casa",
        "number": "100",
        "isDefault": true
      }
    ]
  }
}

script:pre-request {
  bru.deleteVar("userId");
  bru.deleteVar("lastUser");
  bru.deleteVar("photoUrl");
  bru.deleteVar("photoKey");
  bru.deleteVar("coverUrl");
  bru.deleteVar("coverKey");
  bru.deleteVar("profileId");
  bru.deleteVar("lastProfile");
  const suffix = Date.now().toString() + Math.random().toString(36).slice(2, 8);
  bru.setVar("testUsername", "bruno_" + suffix);
  bru.setVar("testPhone", "11" + Date.now().toString().slice(-6) + Math.floor(Math.random() * 1000).toString().padStart(3, "0"));
  bru.setVar("testEmail", "bruno." + suffix + "@example.com");
}

script:post-response {
  if (res.getStatus() === 201) {
    const user = res.getBody().data;
    bru.setVar("loginEmail", user.email);
    bru.setVar("userId", user.userId);
    bru.setVar("lastUser", JSON.stringify(user));
  }
}


docs {
  Cria um usuário usando POST /users.
  Gera username, e-mail e telefone únicos e salva userId para as próximas requisições.
  Envia apenas o objeto JSON no body, sem foto e sem chamadas ao bucket.
  Envie perfil e capa separadamente nas requisições da pasta Fotos.
}
