meta {
  name: Atualizar usuário (PUT)
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/users/{{userId}}
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "name": "Maria Atualizada",
    "username": "{{updateUsername}}",
    "email": "{{updateEmail}}",
    "phone": "{{updatePhone}}",
    "password": "{{loginPassword}}"
  }
}

script:pre-request {
  if (!bru.getVar("userId")) {
    throw new Error("Execute primeiro Criar usuário para preencher userId.");
  }
  const current = JSON.parse(bru.getVar("lastUser") || "null");
  if (!current) {
    throw new Error("Execute Usuário autenticado para carregar os dados atuais antes do PUT.");
  }
  bru.setVar("updateUsername", current.username);
  bru.setVar("updateEmail", current.email);
  bru.setVar("updatePhone", current.phone);
  bru.setVar("userBeforePut", bru.getVar("lastUser"));
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("lastUser", JSON.stringify(res.getBody().data));
  }
}
